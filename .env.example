# Copy to .env.local or .env for local development (never commit real secrets)

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session signing + OTP hashing (min 32 characters; e.g. openssl rand -base64 32)
AUTH_SECRET=

# Ask Linda → NMAC KPI bridge (server-to-server from Ask Linda chat)
# Generate: openssl rand -base64 32
ASK_LINDA_KPI_API_SECRET=

# Configure the Ask Linda deployment with the same secret plus:
# NMAC_KPI_API_URL=https://kpi.nmac.bm
# ASK_LINDA_KPI_API_SECRET=<same value>
# ASK_LINDA_KPI_CHAT_ENABLED=1
# ASK_LINDA_KPI_TIMEOUT_MS=45000
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=
GRAPH_SENDER_NAME=NMAC KPI

# 3CX scheduled report email import
# The mailbox that receives the daily 3CX report attachments.
GRAPH_3CX_REPORT_MAILBOX=
# Optional filters for matching the right report email.
GRAPH_3CX_SUBJECT_QUERY=3CX
GRAPH_3CX_SENDER=
GRAPH_3CX_FOLDER=inbox
# Polling window timezone: 9:00 AM-11:59 AM Asia/Manila.
GRAPH_3CX_POLL_TIME_ZONE=Asia/Manila
# Report-day timezone used when saving daily 3CX data.
GRAPH_3CX_REPORT_TIME_ZONE=Atlantic/Bermuda
# Optional; falls back to CRON_SECRET.
GRAPH_3CX_CRON_SECRET=
GRAPH_3CX_IMPORT_ACTOR_EMAIL=

# ARDTS referral tracker (Referral KPI page)
ARDTS_API_BASE_URL=https://referrals.nmac.bm
ARDTS_INTEGRATION_API_TOKEN=

# NMAC CRM — checked-out appointments for survey outreach
NMAC_CRM_BASE_URL=https://crm.nmac.bm
REPORTS_API_TOKEN=

# Provider experience survey outreach
APP_BASE_URL=https://kpi.nmac.bm
SURVEY_OUTREACH_SECRET=
CRON_SECRET=
# Allowed values: 14 or 21 days after the initial survey.
SURVEY_FINAL_REMINDER_DAYS=14
# Test schedule sends are limited to this comma-separated list while production sending is off.
SURVEY_OUTREACH_TEST_EMAILS=kim.ramirez@ucg.bm
# Required when live sending is enabled. Use the go-live timestamp so old checked-out visits are skipped.
# Example: 2026-07-08T14:00:00Z
SURVEY_OUTREACH_LIVE_START_AT=
# Master switch. Must be "true" before the in-app Survey outreach toggle can send live patient emails.
SURVEY_OUTREACH_SEND_EMAILS=false

# Optional auth
# AUTH_ALLOWED_EMAIL_DOMAINS=ucg.bm
# AUTH_BOOTSTRAP_ADMIN_EMAILS=
# BITRIX_ALLOWED_PORTALS=
